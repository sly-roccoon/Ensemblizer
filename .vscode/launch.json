{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Reaper with Test Project...",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "C:/Program Files/REAPER (x64)/reaper.exe",
      "internalConsoleOptions": "openOnSessionStart",
      "args": [
        "${workspaceFolder}/test.rpp"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: build"
    },
    {
      "type": "cmake",
      "request": "launch",
      "name": "Debug portfile(s)",
      "cmakeDebugType": "external",
      "pipeName": "\\\\.\\pipe\\vcpkg_ext_portfile_dbg",
      "preLaunchTask": "Debug vcpkg commands"
    }
  ]
}